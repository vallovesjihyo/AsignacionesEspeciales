<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    tools:context=".SimpleActivity">

    <!-- ═══════════════════════════════════════════════ -->
    <!--  HEADER con gradiente premium                  -->
    <!-- ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="36sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensor Bluetooth"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conexión de Dispositivos"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Controles"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBluetooth"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            app:backgroundTint="#000000"
            app:cornerRadius="24dp"
            android:layout_marginBottom="16dp"
            app:icon="@android:drawable/stat_sys_data_bluetooth"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconTint="#FFFFFF"
            android:onClick="onBluetooth" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscarDispositivo"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="BUSCAR DISPOSITIVOS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            app:backgroundTint="#000000"
            app:cornerRadius="24dp"
            android:enabled="false"
            android:layout_marginBottom="24dp"
            app:icon="@android:drawable/ic_menu_search"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconTint="#FFFFFF"
            android:onClick="onBuscarDispositivo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dispositivos Disponibles"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="4dp" />

        <ListView
            android:id="@+id/lvDispositivos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_config_row"
            android:layout_marginBottom="16dp"
            android:divider="#222222"
            android:dividerHeight="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDataSend"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="FINALIZAR"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            app:backgroundTint="#000000"
            app:cornerRadius="24dp"
            android:onClick="onEnd" />

    </LinearLayout>
</LinearLayout>